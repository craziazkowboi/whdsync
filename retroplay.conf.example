# Amiga Retroplay settings
# Copy this file to retroplay.conf (next to the scripts) and edit it.
# Every setting is optional - anything left out uses the default shown.
# Command-line options always override these. Run ./doctor.sh to check it.

# Which variants all.sh builds (aga ecs rtg aga-laced ecs-laced, or the name
# of any other iGame_NAME artwork folder).
VARIANTS="aga ecs rtg"

# Where retro_*, new_* and working files go. Relative to this folder, or an
# absolute path - e.g. a USB SSD, which is far faster than a Pi's SD card:
# OUTPUT_ROOT="/mnt/ssd/retroplay"
OUTPUT_ROOT="."

# Artwork priority. ART_ORDER_<VARIANT> overrides it for one variant.
ART_ORDER="Covers,Screens,Titles"
DEMO_ART_ORDER="Titles,Screens,Covers"
# ART_ORDER_RTG="Screens,Covers,Titles"

# Artwork packs matched ONLY by the standard layout
#   <Covers|Screens|Titles>/<Games|Demos|Magazines>/<letter>/<game>/iGame.iff
# (names as after "iGame_", e.g. ART for iGame_art). Every other pack is ALSO
# searched for a folder named after the game anywhere inside it.
STRUCTURED_ART_SETS="AGA ECS RTG"

# Release tags a variant leaves out. ECS machines can't run AGA or CD32
# releases, so by default the ECS variants skip them. Set to "" to keep all.
# EXCLUDE_TAGS_ECS="AGA,CD32"
# EXCLUDE_TAGS_ECS_LACED="AGA,CD32"

# ---- Artwork packs (iGame_*, TinyLauncher) -------------------------------
# Fetch artwork during a normal run: no | ask (by hand only) | auto | yes
ARTWORK_SYNC="ask"
ARTWORK_SOURCE_URL="https://ftp2.grandis.nu/turran/FTP/Collection/Various/WHDLoad_Images"
# Variants whose artwork is kept up to date by default (each fetches the
# three sections: Covers, Screens, Titles). Use aga-laced / ecs-laced for the
# Laced flavour; plain aga/ecs use LoRes.
ARTWORK_PACKS="AGA ECS RTG"
# Others, on request only: ./start.sh --artwork-sync --set art
ARTWORK_OPTIONAL_PACKS="AGA_Laced ECS_Laced art TinyLauncher"
# If you've changed an artwork folder yourself:
#   ask (keeps yours when unattended) | keep-local | backup-and-replace | fail
ARTWORK_LOCAL_CHANGE_POLICY="ask"
# If artwork can't be updated: warn-and-continue (keep old art, carry on) | fail
ARTWORK_FAILURE_POLICY="warn-and-continue"
ARTWORK_KEEP_BACKUPS=2
ARTWORK_CHECK_INTERVAL_HOURS=24
ARTWORK_VERIFY_DOWNLOADS="yes"
# Where downloaded artwork archives are cached (not inside the live folders).
ARTWORK_ARCHIVE_DIR="artwork_archive"

# ---- Artwork for games the packs don't cover -----------------------------
# As a last resort, after every artwork pack has been tried, a command of
# YOUR choosing can be asked for a picture. Whatever it returns is converted
# to a proper Amiga IFF ILBM (same size and colours as your other artwork)
# and installed into artwork/iGame_art/ and the collection.
#
# The command is called as:   <command> "<game name>" "<output .png>"
# It should write one image and exit 0, or exit non-zero if it found nothing.
# Examples of what people plug in here: an AI command line tool, an image
# search API wrapper, or a script that picks from a folder of pictures.
# Needs python3 with Pillow (sudo apt install python3-pil).
ARTWORK_FETCH="no"
ARTWORK_FETCH_COMMAND=""
ARTWORK_FETCH_LIMIT=25

# Amiga filename limits: pfs (107 characters) or ffs (30 characters).
# For PFS, run  setfnsize <drive:> 107  on the Amiga first.
FILESYSTEM="pfs"

# Run detox to clean up filenames before sorting (yes/no).
USE_DETOX="no"

# Disk space: always leave this much free (MB), and assume extracted
# archives take this many times their compressed size.
MIN_FREE_MB=1024
SPACE_FACTOR=3

# Failed extractions of one archive before it's moved to old/corrupt-<date>/
# (so the next update downloads a fresh copy), and download attempts.
MAX_EXTRACT_ATTEMPTS=3
DOWNLOAD_RETRIES=3

# The artwork gap-fill runs when an artwork pack changes, or after this many days.
GAPFILL_DAYS=7

# Test new downloads straight away (a corrupt one is fetched again in the
# same run): yes, no, or auto (= only batches of up to 100 files, so a huge
# first download isn't slowed down).
VERIFY_DOWNLOADS="auto"

# How many dated new_<variant>/ batch folders to keep.
KEEP_NEW_BATCHES=14

# Days to keep superseded archives in old/ before deleting them.
OLD_ARCHIVE_DAYS=30

# Keep rolling copies of the .retroplay state folder? It only holds the
# queue and build markers, and the next run rebuilds what it needs, so this
# is off by default.
STATE_BACKUP="no"

# If STATE_BACKUP="yes": largest backup to make (MB). Backups cover the queue and build
# markers only; previous artwork versions are never included.
STATE_BACKUP_MAX_MB=50

# Delete logs older than this many days; 0 keeps them for ever.
LOG_RETENTION_DAYS=1

# Folder names (or absolute paths). artwork/downloads/logs sit beside the
# scripts; the builds go under OUTPUT_ROOT.
ARTWORK_DIR="artwork"
BUILD_DIR="build"
DOWNLOAD_DIR="downloads"
LOG_DIR="logs"

# Nightly log (all_cron.log) rotation.
LOG_MAX_MB=5
LOG_KEEP=4

# Notifications when a run fails (and optionally when it succeeds).
# ntfy: install the ntfy app, subscribe to a hard-to-guess topic name.
NTFY_TOPIC=""
NTFY_SERVER="https://ntfy.sh"
# Email needs a working 'mail' command on this machine.
NOTIFY_EMAIL=""
NOTIFY_ON_SUCCESS="no"
