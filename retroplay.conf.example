# Amiga Retroplay settings
# Copy this file to retroplay.conf (next to the scripts) and edit it.
# Every setting is optional - anything left out uses the default shown.
# Command-line options always override these. Run ./doctor.sh to check it.

# Which Retroplay folders are mirrored into downloads/, comma separated.
# Each must be a folder under WHDLoad/, HD_Loaders/ or JST/ (anything else is
# ignored with a warning); the server name is worked out from it, so
# "WHDLoad/Games" is fetched from Commodore_Amiga_-_WHDLoad_-_Games.
# To add the beta and unreleased games, append:  , WHDLoad/Games/Beta & Unreleased
MIRROR_DIRS="HD_Loaders/Games, JST/Games, WHDLoad/Magazines, WHDLoad/Demos, WHDLoad/Games"

# Which variants all.sh builds (aga ecs rtg aga-laced ecs-laced, or the name
# of any other iGame_NAME artwork folder).
# Each variant is a COMPLETE collection of its own on the drive - five of
# them is roughly five times the space of one, and five times the artwork
# merge time. Trim this list on a small SD card or a Pi Zero, e.g.
#   VARIANTS="aga ecs rtg"
VARIANTS="aga ecs rtg aga-laced ecs-laced"

# Where retro_*, new_* and working files go. Relative to this folder, or an
# absolute path - e.g. a USB SSD, which is far faster than a Pi's SD card:
# OUTPUT_ROOT="/mnt/ssd/retroplay"
OUTPUT_ROOT="."

# Artwork priority. ART_ORDER_<VARIANT> overrides it for one variant.
ART_ORDER="Screens,Covers,Titles"
DEMO_ART_ORDER="Titles,Screens,Covers"
ART_ORDER_RTG="Covers,Screens,Titles"

# Artwork packs matched ONLY by the standard layout
#   <Covers|Screens|Titles>/<Games|Demos|Magazines>/<letter>/<game>/iGame.iff
# (names as after "iGame_", e.g. ART for iGame_art). Every other pack is ALSO
# searched for a folder named after the game anywhere inside it.
STRUCTURED_ART_SETS="AGA ECS RTG"

# Release tags a variant leaves out. ECS machines can't run AGA or CD32
# releases, so by default the ECS variants skip them. Set to "" to keep all.
# EXCLUDE_TAGS_ECS="AGA,CD32"
# EXCLUDE_TAGS_ECS_LACED="AGA,CD32"

# ---- Artwork packs (iGame_*, TinyLauncher) -------------------------------
# Fetch artwork during a normal run: no | ask (by hand only) | auto | yes
ARTWORK_SYNC="auto"
ARTWORK_SOURCE_URL="https://ftp2.grandis.nu/turran/FTP/Collection/Various/WHDLoad_Images"
# Variants whose artwork is kept up to date by default (each fetches the
# three sections: Covers, Screens, Titles). Use aga-laced / ecs-laced for the
# Laced flavour; plain aga/ecs use LoRes.
# Keep this in step with VARIANTS: a variant whose pack is not listed here is
# built from the fallback chain, so retro_aga_laced would come out identical
# to retro_aga.
ARTWORK_PACKS="AGA ECS RTG AGA_Laced ECS_Laced"
# Others, on request only: ./start.sh --artwork-sync --set art
ARTWORK_OPTIONAL_PACKS="art TinyLauncher"
# If you've changed an artwork folder yourself:
#   ask (keeps yours when unattended) | keep-local | backup-and-replace | fail
ARTWORK_LOCAL_CHANGE_POLICY="ask"
# If artwork can't be updated: warn-and-continue (keep old art, carry on) | fail
ARTWORK_FAILURE_POLICY="warn-and-continue"
ARTWORK_KEEP_BACKUPS=2
ARTWORK_CHECK_INTERVAL_HOURS=24
ARTWORK_VERIFY_DOWNLOADS="yes"
# Where downloaded artwork archives are cached (not inside the live folders).
ARTWORK_ARCHIVE_DIR="artwork_archive"

# ---- Artwork for games the packs don't cover -----------------------------
# As a last resort, after every artwork pack has been tried, a command of
# YOUR choosing can be asked for a picture. Whatever it returns is converted
# to a proper Amiga IFF ILBM (same size and colours as your other artwork)
# and installed into artwork/iGame_art/ and the collection.
#
# The command is called as:   <command> "<game name>" "<output .png>"
# It should write one image and exit 0, or exit non-zero if it found nothing.
# Examples of what people plug in here: an AI command line tool, an image
# search API wrapper, or a script that picks from a folder of pictures.
# Needs python3 with Pillow (sudo apt install python3-pil).
# The command is called as:   <your command> "<game name>" "<output image>"
# and should write a picture file to the path it is given. It may carry its
# own arguments; the setting is split on whitespace into a plain argument
# list and run directly, NOT through a shell. So:
#   ARTWORK_FETCH_COMMAND="python3 /home/pi/bin/findart.py --source local"
# works, while pipes, redirection, $VARIABLES, quotes and paths containing
# spaces do not - put those in a small wrapper script and name that instead.
ARTWORK_FETCH="no"
ARTWORK_FETCH_COMMAND=""
ARTWORK_FETCH_LIMIT=25

# Be gentle with the machine during unattended runs: auto (the default) adds
# nice, and ionice on Linux, to the extraction workers when the run is not
# attached to a terminal - a nightly build then leaves a Pi usable. Set to
# "no" to run everything at normal priority.
# NICE="auto"

# Amiga filename limits: pfs (107 characters) or ffs (30 characters).
# For PFS, run  setfnsize <drive:> 107  on the Amiga first.
FILESYSTEM="pfs"

# Run detox to clean up filenames before sorting (yes/no).
USE_DETOX="no"

# Make names Amiga-safe at the end of every run that changed something (yes/no).
# Runs amiga_names.py (beside the scripts; needs python3) over each collection
# and each dated batch in the build folder: accented letters lose their accent
# (é -> e; ä ö ü ß -> ae oe ue ss) and the characters # ? \ become _.
# - and + are legal on the Amiga and are left exactly as they are.
# A name is left alone when the Amiga-safe one is already taken. What changed
# is listed in logs/amiga_names.log and counted in the run report.
# For one run: ./all.sh --no-amiga-names  (or --amiga-names to force it on).
# To see what it would change without changing it: ./start.sh --plan
AMIGA_NAMES="yes"

# Disk space: always leave this much free (MB), and assume extracted
# archives take this many times their compressed size.
MIN_FREE_MB=1024
SPACE_FACTOR=3

# Failed extractions of one archive before it's moved to old/corrupt-<date>/
# (so the next update downloads a fresh copy), and download attempts.
MAX_EXTRACT_ATTEMPTS=3
DOWNLOAD_RETRIES=3

# How long downloads may take, in seconds.
# DOWNLOAD_TIMEOUT: how long any download may sit with nothing arriving -
#   connecting, or stalled part-way - before that attempt is given up and
#   tried again (DOWNLOAD_RETRIES above). It is NOT a limit on a whole
#   download: the first mirror of the game archives takes hours and is never
#   cut short while data keeps coming. Raise it on a very poor connection.
# ARTWORK_TIMEOUT: the most one artwork pack may take from start to finish.
#   A pack is hundreds of MB; one that runs out of time is left exactly as it
#   was and tried again on the next run. 0 = no limit.
DOWNLOAD_TIMEOUT=60
ARTWORK_TIMEOUT=3600

# The artwork gap-fill runs when an artwork pack changes, or after this many days.
GAPFILL_DAYS=7

# Test new downloads straight away (a corrupt one is fetched again in the
# same run): yes, no, or auto (= only batches of up to 100 files, so a huge
# first download isn't slowed down).
VERIFY_DOWNLOADS="auto"

# How many dated new_<variant>/ batch folders to keep.
KEEP_NEW_BATCHES=14

# Days to keep superseded archives in old/ before deleting them.
OLD_ARCHIVE_DAYS=30

# Keep rolling copies of the .retroplay state folder? It only holds the
# queue and build markers, and the next run rebuilds what it needs, so this
# is off by default.
STATE_BACKUP="no"

# If STATE_BACKUP="yes": largest backup to make (MB). Backups cover the queue and build
# markers only; previous artwork versions are never included.
STATE_BACKUP_MAX_MB=50

# Say when a newer release exists. This only ever READS a version number
# from GitHub over HTTPS: it never downloads an archive and never runs
# anything - it prints the address and the commands, and you decide.
UPDATE_CHECK="yes"
UPDATE_CHECK_INTERVAL_HOURS=24

# Progress bar: auto (blocks on macOS, ASCII on Linux/A314), smooth, or ascii.
PROGRESS_STYLE="auto"

# Folder names (or absolute paths). artwork/downloads/logs sit beside the
# scripts; the builds go under OUTPUT_ROOT.
# The logs folder also holds the run report. It is cleared at the start of
# every run and only the latest report is kept, so it always describes the
# most recent run and nothing else. (LOG_RETENTION_DAYS, LOG_MAX_MB and
# LOG_KEEP from earlier versions are still accepted, but no longer used.)
# RUN_LOG: a run you start by hand at a terminal is also copied, as plain
# text, to logs/last_run.log (the nightly run already has all_cron.log).
# It needs the "script" command, which Raspberry Pi OS and macOS both have.
RUN_LOG="yes"
ARTWORK_DIR="artwork"
BUILD_DIR="build"
DOWNLOAD_DIR="downloads"
LOG_DIR="logs"

# Notifications when a run fails (and optionally when it succeeds).
# ntfy: install the ntfy app, subscribe to a hard-to-guess topic name.
NTFY_TOPIC=""
NTFY_SERVER="https://ntfy.sh"
# Email needs a working 'mail' command on this machine.
NOTIFY_EMAIL=""
NOTIFY_ON_SUCCESS="no"

# ---- How many things to do at once ---------------------------------------
# "auto" is what each stage works out for itself from the CPU count, capped
# again by how much memory the machine has - which is what these scripts have
# always done. Set a number only if you have measured that it helps: the run
# report now prints the time each stage took, which is the place to look.
#
# On a Pi Zero 2 W with the collection on an SD card, 1 is often faster than
# the automatic choice; on a desktop with an NVMe drive, more can help.
JOBS="auto"
# Per stage, if one of them is the problem rather than all of them.
EXTRACT_JOBS="auto"
MERGE_JOBS="auto"
SORT_JOBS="auto"
